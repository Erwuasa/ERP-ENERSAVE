# Copia este archivo a .env y rellena los valores
# cp .env.example .env

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Supabase (cliente Vite — prefijo VITE_ obligatorio)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Ventas RLS: cada comercial debe existir en Supabase Auth con el mismo email
# que erp_comerciales (ej. ignacio@enersave.com) y contraseña demo 123456.
# En Authentication → Providers desactiva «Confirm email» en desarrollo, o confirma usuarios manualmente.
# Aplica migraciones en supabase/migrations (especialmente 20260618000003 y 20260618000004).

# Solo backend / migraciones (no exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Opcional: aplicar migraciones SQL desde terminal (scripts/apply-supabase-sql.mjs)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...  # https://supabase.com/dashboard/account/tokens
